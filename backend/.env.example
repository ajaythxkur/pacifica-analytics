# Pacifica Analytics — backend env
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------
# Elfa AI — required for /api/sentiment/* endpoints
# Get a free key at https://go.elfa.ai/dev
# Without this key, sentiment endpoints will return empty arrays
# (the rest of the app continues to work).
# ---------------------------------------------------------------
ELFA_API_KEY=

# ---------------------------------------------------------------
# Telegram Bot — optional, enables /api/telegram/* + the alerts bot
#
# 1. Talk to @BotFather on Telegram, /newbot, follow prompts.
# 2. Paste the token below (looks like 123456:AAH...).
# 3. Optionally set the bot username (without the @) so the frontend
#    CTA can deep-link to t.me/<username>.
#
# Without these, the bot is disabled and the rest of the app works
# normally.
# ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Used by the bot's "View Trader Profile" buttons. In dev this is localhost;
# in production set it to your deployed frontend URL (e.g. Vercel).
APP_PUBLIC_URL=http://localhost:3000

# Where to keep the SQLite subscriber DB. On Render/Railway/Fly,
# point this at a persistent disk mount (e.g. /data/subscribers.db).
SUBSCRIBERS_DB_PATH=subscribers.db

# ---------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# Examples:
#   ALLOWED_ORIGINS=http://localhost:3000
#   ALLOWED_ORIGINS=https://pacifica-analytics.vercel.app,https://staging.example.com
#   ALLOWED_ORIGINS=*               # allow any (credentials disabled)
# ---------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
